# Sito del Gruppo Scout Palermo 11 sull'hosting (Apache). Questo file finisce in public_html
# insieme al sito compilato.

Options -Indexes
RewriteEngine On

# Sempre in HTTPS: chi arriva in chiaro viene rimandato all'indirizzo protetto.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Gli indirizzi del sito (es. /canzoniere/806) non sono file veri: li apre l'app, che
# parte da index.html. I file che esistono (script, immagini…) si servono così come sono.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "DENY"
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
  # index.html si ricontrolla sempre, così dopo un aggiornamento si vede subito il sito nuovo;
  # gli script e gli stili hanno il nome che cambia a ogni versione e si tengono a lungo.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "-[0-9A-Z]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
