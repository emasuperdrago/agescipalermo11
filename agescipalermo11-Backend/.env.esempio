# Copia questo file in ".env" e riempilo. Il file .env non va condiviso con nessuno
# e non va messo su GitHub: contiene le chiavi di questo sito.

# Chiave con cui si firmano i token di accesso (almeno 32 caratteri a caso).
# Se la lasci vuota, alla prima accensione il server ne crea una e la scrive qui.
# Per farne una a mano: openssl rand -base64 48
JWT_SECRET=

# Chiave che cifra il database (64 caratteri esadecimali). Se la lasci vuota, alla prima
# accensione il server ne crea una e la scrive qui. SE LA PERDI, PERDI TUTTI I DATI:
# tienine una copia in un posto sicuro (un gestore di password), mai insieme al database.
# Online va messa la STESSA del Mac (la prepara "npm run server:prepara").
DB_KEY=

# Indirizzi del sito ammessi a parlare col backend, separati da virgola.
ALLOWED_ORIGINS=http://localhost:8100

# Porta del backend (se manca, 3000).
PORT=3000

# --- HTTPS ---
# Senza HTTPS il backend ascolta solo su questo computer (localhost): dal Wi-Fi non lo
# raggiunge nessuno, così password e token non viaggiano mai in chiaro sulla rete.
# Per provarlo dal telefono accendi l'HTTPS qui sotto (e il sito con: npm run start:https).
# Percorsi del certificato, se è il backend stesso a parlare in HTTPS.
# HTTPS_KEY=certificati/chiave.pem
# HTTPS_CERT=certificati/certificato.pem

# Metti 1 se davanti c'è un proxy (Nginx, il servizio di hosting…) che fa l'HTTPS al posto nostro.
# DIETRO_PROXY=1

# Metti 1 per rimandare in HTTPS chi arriva in chiaro.
# FORZA_HTTPS=1

# Metti "production" quando il sito è online: fa sparire l'admin di prova, accetta solo
# gli indirizzi di ALLOWED_ORIGINS, e il backend NON parte senza HTTPS (o DIETRO_PROXY=1).
# NODE_ENV=production

# --- Email (conferma dell'indirizzo alla registrazione) ---
# Per le prove in locale va bene un account Gmail con una "password per le app"
# (Account Google → Sicurezza → Verifica in due passaggi → Password per le app).
# Più avanti si mettono qui i dati della casella del dominio del gruppo: il codice non cambia.
# Senza queste righe le email non partono; fuori dalla produzione il link di conferma
# si legge nel terminale del backend.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_UTENTE=indirizzo@gmail.com
# SMTP_PASSWORD=la-password-per-le-app
# MAIL_MITTENTE="Gruppo Scout Palermo 11 <indirizzo@gmail.com>"
# L'indirizzo del sito a cui portano i link nelle email (online: https://www.tuodominio.it).
# SITO_URL=http://localhost:8101

# --- Database (PostgreSQL) ---
# In locale: il PostgreSQL del Mac sulla porta 5432 (si accende con "npm run db:avvia").
# Online: i dati del database PostgreSQL che dà l'hosting. Le tabelle si creano da sole al
# primo avvio; i dati si portano una volta con lo script di migrazione.
# DB_SSL=1 se il database sta su un altro server (collegamento cifrato).
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=palermo11
# DB_USER=palermo11
# DB_PASSWORD=...
#
# DB_KEY (qui sopra) ora cifra i dati personali dentro il database (email, telefoni, date di
# nascita, contatti, note e genitori delle richieste): online va messa LA STESSA, altrimenti
# il server si ferma perché quei dati non si leggerebbero più.
